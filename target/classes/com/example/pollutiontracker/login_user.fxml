<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<StackPane style="-fx-background-color: #0d0d1a;"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.pollutiontracker.LoginUserController">


    <VBox alignment="CENTER"
          spacing="15"
          prefWidth="450"
          prefHeight="400"
          maxWidth="450"
          maxHeight="400"
          stylesheets="@styles.css"
          styleClass="login-card">


        <Label text="LOGIN TO THE SYSTEM"
               styleClass="login-title">
            <VBox.margin>
                <Insets top="5" bottom="15"/>
            </VBox.margin>
        </Label>

        <TextField fx:id="usernameField"
                   promptText="Username"
                   maxWidth="350"
                   styleClass="input-field"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       maxWidth="350"
                       styleClass="input-field"/>



        <Button maxWidth="200"
                text="Login"
                onAction="#loginAction"
                styleClass="login-btn"/>


        <Label fx:id="messageLabel"
               style="-fx-text-fill: #ff6b6b;"/>

        <padding>
            <Insets top="20" bottom="20" left="30" right="30"/>
        </padding>

    </VBox>

</StackPane>